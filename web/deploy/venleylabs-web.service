# The website on the Raspberry Pi. Install: sudo cp venleylabs-web.service /etc/systemd/system/
[Unit]
Description=Venley Labs website
After=network-online.target
Wants=network-online.target

[Service]
User=joaoelvas
WorkingDirectory=/opt/venleylabs-web
# Port 3000 is the Telltale site. serve comes from the build folder's node_modules.
ExecStart=/opt/venleylabs-web/build/node_modules/.bin/serve /opt/venleylabs-web/current -l tcp://127.0.0.1:3001 --no-port-switching --no-clipboard
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
